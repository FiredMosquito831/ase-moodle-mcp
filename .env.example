# Exemplu de configurare locala. Copiaza fisierul ca .env (acela NU intra in git) si completeaza valorile.
#
#   copy .env.example .env
#
# Nu pune niciodata tokenul sau parola in fisiere care se commit-uiesc. .env este in .gitignore.
# Daca nu folosesti .env, `ase-moodle login` tine tokenul in Windows Credential Manager.

# Tokenul "Moodle mobile web service" (online.ase.ro -> Preferinte -> Chei de securitate).
# Lasa gol daca folosesti `ase-moodle login`.
ASE_MOODLE_TOKEN=

# Adresa Moodle. Pentru teste locale, vezi .env.test (serverul fals).
ASE_MOODLE_URL=https://online.ase.ro

# Folderul unde se descarca materialele (implicit ~/ASE-Moodle).
ASE_MOODLE_DOWNLOADS=

# 1 = scrierile (trimiteri, raspunsuri la quiz, mesaje) nu mai cer confirmare. Nu recomand.
ASE_MOODLE_AUTO_CONFIRM=0
