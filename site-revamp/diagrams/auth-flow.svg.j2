<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 960 540" role="img" aria-labelledby="af-title af-desc">
  <title id="af-title">{{ labels.title }}</title>
  <desc id="af-desc">{{ labels.desc }}</desc>
  <defs>
    <marker id="af-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0L10 5L0 10z" fill="#5B9DFF"/>
    </marker>
    <marker id="af-arrow-muted" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0L10 5L0 10z" fill="#A7B6C9"/>
    </marker>
  </defs>
  <style>
    .bg { fill: #0A0E14; }
    .panel { fill: #111722; stroke: #5A6B82; stroke-width: 1; }
    .panel2 { fill: #17202D; stroke: #5A6B82; stroke-width: 1; }
    .title { fill: #E8EEF6; font: 700 24px system-ui, sans-serif; }
    .num { fill: #1F6FEB; }
    .numtext { fill: #FFFFFF; font: 700 15px ui-monospace, Consolas, monospace; }
    .name { fill: #E8EEF6; font: 600 17px ui-monospace, Consolas, monospace; }
    .sub { fill: #A7B6C9; font: 400 14px system-ui, sans-serif; }
    .h { fill: #A7B6C9; font: 600 13px system-ui, sans-serif; letter-spacing: .1em; text-transform: uppercase; }
    .legend { fill: #A7B6C9; font: 400 13px system-ui, sans-serif; }
    .line { stroke: #5B9DFF; stroke-width: 2; fill: none; }
    .dash { stroke: #A7B6C9; stroke-width: 2; stroke-dasharray: 6 6; fill: none; }
  </style>
  <rect class="bg" width="960" height="540" rx="16"/>
  <text x="40" y="46" class="title">{{ labels.title }}</text>

  {% for step in labels.steps %}
  <rect class="panel" x="40" y="{{ 78 + loop.index0 * 82 }}" width="540" height="64" rx="10"/>
  <circle class="num" cx="72" cy="{{ 110 + loop.index0 * 82 }}" r="16"/>
  <text x="72" y="{{ 116 + loop.index0 * 82 }}" class="numtext" text-anchor="middle">{{ loop.index }}</text>
  <text x="102" y="{{ 104 + loop.index0 * 82 }}" class="name">{{ step[0] }}</text>
  <text x="102" y="{{ 126 + loop.index0 * 82 }}" class="sub">{{ step[1] }}</text>
  {% if not loop.last %}
  <path class="line" d="M310 {{ 142 + loop.index0 * 82 }}V{{ 156 + loop.index0 * 82 }}" marker-end="url(#af-arrow)"/>
  {% endif %}
  {% endfor %}

  <rect class="panel2" x="620" y="150" width="300" height="170" rx="12"/>
  <text x="640" y="182" class="name">{{ labels.manual_title }}</text>
  {% for line in labels.manual_lines %}
  <text x="640" y="{{ 210 + loop.index0 * 22 }}" class="sub">{{ line }}</text>
  {% endfor %}
  <path class="dash" d="M580 242H620" marker-end="url(#af-arrow-muted)"/>

  {% for line in labels.after_lines %}
  <text x="620" y="{{ 366 + loop.index0 * 22 }}" class="sub">{{ line }}</text>
  {% endfor %}

  <text x="40" y="500" class="h">{{ labels.legend }}</text>
  <path class="line" d="M40 518H76" marker-end="url(#af-arrow)"/>
  <text x="86" y="523" class="legend">{{ labels.legend_once }}</text>
  <path class="dash" d="M250 518H286" marker-end="url(#af-arrow-muted)"/>
  <text x="296" y="523" class="legend">{{ labels.legend_each }}</text>
</svg>
